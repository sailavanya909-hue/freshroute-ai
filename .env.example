# Copy to .env for Docker Compose only. Export variables separately for Python.
MYSQL_ROOT_PASSWORD=replace-with-your-local-admin-password
MYSQL_READER_PASSWORD=replace-with-your-local-reader-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Optional external LLM routing. Leave blank to use the working local assistant.
OPENAI_API_KEY=
OPENAI_MODEL=
