{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "costchart",
  "position": {
    "x": 25,
    "y": 385,
    "z": 0,
    "height": 235,
    "width": 1390,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Quotes"
                    }
                  },
                  "Property": "market"
                }
              },
              "queryRef": "Quotes.market",
              "nativeQueryRef": "market"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Quotes"
                    }
                  },
                  "Property": "Quoted Midpoint USD per lb"
                }
              },
              "queryRef": "Quotes.Quoted Midpoint USD per lb",
              "nativeQueryRef": "Quoted Midpoint USD per lb"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Quotes"
                    }
                  },
                  "Property": "Scenario Delivered USD per lb"
                }
              },
              "queryRef": "Quotes.Scenario Delivered USD per lb",
              "nativeQueryRef": "Scenario Delivered USD per lb"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Quoted midpoint versus scenario delivered cost (USD/lb)'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "13D"
                }
              }
            }
          }
        }
      ],
      "background": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#FFFFFF'"
                    }
                  }
                }
              }
            },
            "transparency": {
              "expr": {
                "Literal": {
                  "Value": "0D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
